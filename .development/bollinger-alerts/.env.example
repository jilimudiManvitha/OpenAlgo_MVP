# Copy to .env in this directory. Use each host's OpenAlgo API key (not broker token).
BB_STOCKS_HOST=http://127.0.0.1:5000
BB_STOCKS_WS=ws://127.0.0.1:8765
BB_STOCKS_API_KEY=
# Replace these ports with your actual Crypto instance and WebSocket proxy ports.
BB_CRYPTO_HOST=http://127.0.0.1:5001
BB_CRYPTO_WS=ws://127.0.0.1:8766
BB_CRYPTO_API_KEY=
